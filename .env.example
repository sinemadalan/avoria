AVORIA_ENVIRONMENT=development
AVORIA_DEBUG=true
AVORIA_API_PREFIX=/api/v1
AVORIA_CORS_ORIGINS=["http://localhost:5173"]

AVORIA_DATABASE_URL=sqlite+aiosqlite:///./data/avoria.db
AVORIA_REDIS_URL=redis://localhost:6379/0
AVORIA_RQ_QUEUE_NAME=media

AVORIA_STORAGE_ROOT=./data/media
