AVORIA_ENVIRONMENT=development
AVORIA_DEBUG=true
AVORIA_API_PREFIX=/api/v1
AVORIA_CORS_ORIGINS=["http://localhost:5173"]

AVORIA_DATABASE_URL=sqlite+aiosqlite:///./data/avoria.db
AVORIA_CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
AVORIA_CELERY_RESULT_BACKEND=rpc://
AVORIA_CELERY_TASK_DEFAULT_QUEUE=media
AVORIA_CELERY_RESULT_EXPIRES_SECONDS=86400

AVORIA_STORAGE_ROOT=./data/media
AVORIA_UPLOAD_DIRECTORY=./data/uploads
AVORIA_OUTPUT_DIRECTORY=./data/outputs
AVORIA_MAX_UPLOAD_SIZE_BYTES=2147483648
AVORIA_UPLOAD_CHUNK_SIZE_BYTES=4194304
AVORIA_ALLOWED_MEDIA_EXTENSIONS=[".mp4",".mov",".mkv",".webm",".avi",".mp3",".wav",".m4a",".aac",".flac",".ogg",".opus"]
AVORIA_LOG_DIRECTORY=./data/logs
AVORIA_LOG_LEVEL=INFO

AVORIA_FFMPEG_PATH=ffmpeg
AVORIA_FFPROBE_PATH=ffprobe
AVORIA_FFPROBE_TIMEOUT_SECONDS=30
AVORIA_FFMPEG_TIMEOUT_SECONDS=21600
